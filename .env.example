# ==============================================================================
# 🎬 AGENTIC CINEMA: UNIFIED COST OPTIMIZER & TELEMETRY SUITE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI & AGENT DEVELOPMENT KIT (ADK) API CONFIGURATION
# ------------------------------------------------------------------------------
# Required for Agent 1 (CostOptimizerAgent) scene deconstruction and reasoning.
# Get your Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. PARALLEL SEARCH API CONFIGURATION
# ------------------------------------------------------------------------------
# Required for live video model pricing intelligence and stock footage indexing.
# Get your Parallel API key at: https://parallel.ai/
PARALLEL_API_KEY=your_parallel_api_key_here
PARALLEL_API_URL=https://api.parallel.ai/v1/search

# ------------------------------------------------------------------------------
# 3. CLICKHOUSE TELEMETRY & EMPIRICAL AGENT MEMORY API CONFIGURATION
# ------------------------------------------------------------------------------
# Real-time defect telemetry and empirical rerun tracking for Agent 2.
# 
# Option A: Local Docker Container (Default)
#   docker run -d --name clickhouse-server -p 8123:8123 -p 9000:9000 clickhouse/clickhouse-server
#
# Option B: ClickHouse Cloud (Remote)
#   Create free service at https://clickhouse.cloud
#   Set CLICKHOUSE_HOST to your *.clickhouse.cloud domain, PORT=8443, SECURE=true.
#
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false
CLICKHOUSE_ALLOW_WRITE_ACCESS=true

# Optional ClickHouse Cloud API Key or Service Token:
# If you have a ClickHouse Cloud OpenAPI Key, token, or service password:
CLICKHOUSE_API_KEY=

# ------------------------------------------------------------------------------
# 4. OFFICIAL CLICKHOUSE MODEL CONTEXT PROTOCOL (MCP) CONFIGURATION
# ------------------------------------------------------------------------------
# Command executed to spawn the official ClickHouse MCP stdio JSON-RPC server.
MCP_CLICKHOUSE_COMMAND=uvx mcp-clickhouse
# Optional remote MCP SSE endpoint (if using ClickHouse Cloud Remote MCP):
MCP_CLICKHOUSE_SSE_URL=

# ------------------------------------------------------------------------------
# 5. TELEMETRY LIFECYCLE & LOGGING SETTINGS
# ------------------------------------------------------------------------------
IDLE_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
TELEMETRY_TABLE_NAME=generation_telemetry
TELEMETRY_FALLBACK_FILE=telemetry_fallback.jsonl
