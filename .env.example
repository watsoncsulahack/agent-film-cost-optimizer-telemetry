# Google Gemini Configuration (Google ADK & Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Parallel Search API Configuration (Live Video Model Pricing & Stock Footage Indexing)
PARALLEL_API_KEY=your_parallel_api_key_here

# ClickHouse Configuration (Local Docker or ClickHouse Cloud)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
# Optional ClickHouse Cloud API Key or Service Token:
CLICKHOUSE_API_KEY=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false
CLICKHOUSE_ALLOW_WRITE_ACCESS=true

# ClickHouse MCP Server Configuration
# Command used to launch the official ClickHouse MCP server over stdio
MCP_CLICKHOUSE_COMMAND=uvx mcp-clickhouse
# Optional remote MCP SSE endpoint (if using ClickHouse Cloud Remote MCP)
MCP_CLICKHOUSE_SSE_URL=

# Telemetry Agent Settings
IDLE_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
TELEMETRY_FALLBACK_FILE=telemetry_fallback.jsonl
