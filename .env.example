# Google Gemini / Vertex AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ClickHouse Configuration (Direct or Cloud instance)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false

# ClickHouse MCP Server Configuration
# Command used to launch the official ClickHouse MCP server over stdio
MCP_CLICKHOUSE_COMMAND=uvx mcp-clickhouse
# Optional remote MCP SSE endpoint (if using ClickHouse Cloud Remote MCP)
MCP_CLICKHOUSE_SSE_URL=

# Telemetry Agent Settings
IDLE_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
TELEMETRY_FALLBACK_FILE=telemetry_fallback.jsonl
